{
  "name": "osmogrep-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "pnpm clean && next dev",
    "build": "node scripts/changelog.check.mjs && pnpm clean && next build",
    "check:changelog": "node --test scripts/changelog-policy.test.mjs && node scripts/changelog.check.mjs",
    "dev:fresh": "pnpm clean && next dev",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test lib/*.test.ts lib/footer/*.test.js",
    "check:content": "node --experimental-strip-types scripts/content.check.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "22.12.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "eslint": "9.32.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "$postcss",
      "nanoid@3": "3.3.18",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=7 <11.0.1": "11.0.1",
      "ajv@6": "6.14.0",
      "flatted@3": "3.4.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "js-yaml@4": "4.3.2",
      "browserslist": "4.28.7",
      "@humanfs/node": "0.16.8",
      "baseline-browser-mapping": "2.11.0"
    }
  }
}
